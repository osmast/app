        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btn_store_scale">
        <property name="text">
         <string>Store this scale</string>
        </property>
        <property name="toolTip">
         <string>Store the scale - with its uncertainty - as the calibration in force for the preset in panel 1. Measurements already taken keep the scale they were taken under.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="check_manual_scale">
        <property name="text">
         <string>I know the scale already</string>
        </property>
        <property name="toolTip">
         <string>Use this when you already know the scale - from a stage micrometer, or from the optics' own specification. A hand-entered scale is stored as a claim, not as a measurement.</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="manual_scale_form">
        <item row="0" column="0">
         <widget class="QLabel" name="label_manual_scale">
          <property name="text">
           <string>Scale</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QDoubleSpinBox" name="spin_manual_px_per_um">
          <property name="decimals">
           <number>6</number>
          </property>
          <property name="minimum">
           <double>0.000000000000000</double>
          </property>
          <property name="maximum">
           <double>1000.000000000000000</double>
          </property>
          <property name="singleStep">
           <double>0.010000000000000</double>
          </property>
          <property name="suffix">
           <string> px/um</string>
          </property>
          <property name="toolTip">
           <string>Type the scale you know, in pixels per micrometre - 0.147300 px/um is 147.3 px/mm. It overrides the measurement, and it is stored as hand-entered.</string>
