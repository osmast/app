         <string>Or by hand - the fallback: click the first and the last line of N squares. Coarser than the grid, but it works when the paper is not fully in view.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="manual_form">
