  </property>
  <property name="windowTitle">
   <string>Calibration</string>
  </property>
  <layout class="QVBoxLayout" name="controls_layout">
   <item>
    <widget class="QLabel" name="intro_label">
     <property name="text">
      <string>One photo of the grid paper, one press, one result - stored against the preset name. Every measurement then carries the scale it was taken under.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="preset_group">
     <property name="title">
      <string>1.  Optical chain</string>
     </property>
     <layout class="QVBoxLayout" name="preset_layout">
      <item>
       <layout class="QHBoxLayout" name="preset_actions">
        <item>
         <widget class="QPushButton" name="btn_load_preset">
          <property name="text">
           <string>Load preset...</string>
          </property>
          <property name="toolTip">
           <string>Switch the device in force: pick a stored preset by its name, and that chain's newest scale becomes the one every surface measures with. Nothing is measured or stored - this only chooses.</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_new_preset">
          <property name="text">
           <string>New preset...</string>
          </property>
          <property name="toolTip">
           <string>Start a fresh preset: a popup asks for the device's name, and the measurement is cleared so the next scale you store belongs to a new optical chain. The scale in force is untouched until you store one.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QFormLayout" name="facts_form">
        <item row="0" column="0">
         <widget class="QLabel" name="label_preset">
          <property name="text">
           <string>Preset</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="profile_name">
          <property name="readOnly">
           <bool>true</bool>
          </property>
          <property name="frame">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>The device this panel names - set by 'New preset...' and 'Load preset...', and shown here read-only.</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="label_setup_key">
          <property name="text">
           <string>Setup key</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QLabel" name="setup_key_label">
          <property name="text">
           <string>-</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="label_in_force">
          <property name="text">
           <string>In force</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QLabel" name="in_force_label">
          <property name="text">
           <string>none yet</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="label_calibrations">
          <property name="text">
           <string>Calibrations</string>
          </property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="QLabel" name="history_label">
          <property name="text">
           <string>none stored</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QLabel" name="label_mount">
          <property name="text">
           <string>Mount</string>
          </property>
         </widget>
        </item>
        <item row="4" column="1">
         <widget class="QLabel" name="locked_label">
          <property name="text">
           <string>zoom 1.0x, focus locked at infinity</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
          <property name="toolTip">
           <string>The mount locks zoom and focus, so they are constants of every calibration rather than fields to fill in - the preset name is the whole description of this chain.</string>
          </property>
         </widget>
        </item>
        <item row="5" column="0">
         <widget class="QLabel" name="label_distortion_caption">
          <property name="text">
           <string>Distortion</string>
          </property>
         </widget>
        </item>
        <item row="5" column="1">
         <widget class="QLabel" name="label_distortion">
          <property name="text">
           <string>unmeasured and not corrected - one scale covers the whole frame. Optional: it only matters off-centre.</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
          <property name="toolTip">
           <string>Both routes - the detected grid and a hand-clicked span - only set that one scale; neither of them corrects the lens, and nothing in this app rewrites a frame. A correction is a model fitted for this chain and stored with it, and this chain has none, so the panel says "not corrected" rather than "0 %". You can ignore this while the specimen sits near the centre of the field; the drift line in panel 2 says how much the scale moves towards the edge.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="calibration_actions">
        <item>
         <widget class="QPushButton" name="btn_load_calibration">
          <property name="text">
           <string>Load calibration...</string>
          </property>
          <property name="toolTip">
           <string>Load one of this device's stored calibrations: pick it by date and scale, and it becomes the calibration in force - with its proof photo shown on the canvas. Nothing is measured or stored, and the preset name does not change.</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_new_calibration">
          <property name="text">
           <string>New calibration...</string>
          </property>
          <property name="toolTip">
           <string>Start a fresh calibration of this device: clear the measurement so you can measure the grid again and store a new scale. The calibration in force is untouched until you store one.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="reference_group">
