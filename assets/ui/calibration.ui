      </item>
      <item>
       <layout class="QFormLayout" name="grid_size_form">
        <item row="0" column="0">
         <widget class="QLabel" name="label_grid_mm">
          <property name="text">
           <string>Printed square</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QDoubleSpinBox" name="spin_grid_mm">
          <property name="decimals">
           <number>3</number>
          </property>
          <property name="minimum">
           <double>0.001000000000000</double>
          </property>
          <property name="maximum">
           <double>100.000000000000000</double>
          </property>
          <property name="singleStep">
           <double>0.500000000000000</double>
          </property>
          <property name="value">
           <double>1.000000000000000</double>
          </property>
          <property name="suffix">
           <string> mm</string>
          </property>
          <property name="toolTip">
           <string>Printed spacing of one square of the reference grid: 1 mm for standard grid paper, 0.5 mm or 0.1 mm for finer paper. The detector measures how many pixels one square spans, so the square's true size is what turns that into a scale.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QPushButton" name="btn_measure_grid">
        <property name="text">
         <string>Measure grid</string>
        </property>
        <property name="toolTip">
         <string>Find the printed lattice in this photo and measure its period. The lattice and the paper's circle are drawn on the photo, so the measurement can be seen rather than trusted.</string>
        </property>
       </widget>
      </item>
