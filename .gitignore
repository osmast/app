# ── Local state ──────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# Generated by MediaMTX on startup (self-signed WebRTC certificate)
auto.crt
auto.key

# ── Generated content (keep the folders, ignore their contents) ──
datasets/raw/*
datasets/processed/*
datasets/annotations/*
recordings/*
models/*
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
!datasets/annotations/.gitkeep
!recordings/.gitkeep
!models/.gitkeep
